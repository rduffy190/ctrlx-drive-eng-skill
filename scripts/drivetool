#!/usr/bin/env bash
# Run the DriveTool CLI (EAL-based ctrlX DRIVE tool). Rebuilds when sources are newer than the binary.
# Project location: $DRIVETOOL_PROJECT (default: drivetool/ in this skill).
set -euo pipefail
PROJECT="${DRIVETOOL_PROJECT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../drivetool" && pwd)}"
DLL="$PROJECT/bin/Debug/net10.0/drivetool.dll"
if [[ ! -d "$PROJECT" ]]; then
  echo "DriveTool project not found at $PROJECT (set DRIVETOOL_PROJECT)" >&2
  exit 2
fi
if [[ ! -f "$DLL" ]] || [[ -n "$(find "$PROJECT" \( -name '*.cs' -o -name '*.csproj' -o -name '*.json' \) -not -path '*/bin/*' -not -path '*/obj/*' -newer "$DLL" -print -quit)" ]]; then
  echo "Building DriveTool ..." >&2
  dotnet build "$PROJECT" -nologo -v q >&2
fi
exec dotnet "$DLL" "$@"
